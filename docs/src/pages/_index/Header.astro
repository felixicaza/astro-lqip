---
import { Picture } from 'astro-lqip/components'

import Tab from '@components/Tab.astro'

import logo from '@images/logo.png'
---

<header>
  <div>
    <Picture alt="Astro LQIP Logo" fallbackFormat="webp" fetchpriority="high" formats={['avif', 'webp']} height={150} src={logo} width={150} />
    <hgroup>
      <h1>Astro LQIP</h1>
      <p>
        Native extended Astro components for generating low-quality image placeholders (LQIP), compatible with
        <code>&lt;Image&gt;</code>
        ,
        <code>&lt;Picture&gt;</code>
        {' '}
        and CSS background images.
      </p>
    </hgroup>
  </div>
  <Tab />
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: 36px;

    & div {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;

      & hgroup {
        display: flex;
        flex-direction: column;
        gap: 8px;
        text-align: center;

        & h1 {
          font-size: 3.5rem;
          color: #bcb5f3;
          margin-block: 0;
        }

        & p {
          margin-block: 0;
          max-width: 580px;
          text-wrap: balance;
        }
      }
    }
  }
</style>
