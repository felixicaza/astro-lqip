{
  "name": "@felixicaza/astro-lqip",
  "version": "0.0.0",
  "private": true,
  "description": "The astro-lqip monorepo",
  "license": "MIT",
  "author": "Felix Icaza <contacto@felixicaza.com>",
  "type": "module",
  "scripts": {
    "astro:sync": "turbo astro:sync",
    "astro:typecheck": "turbo astro:typecheck",
    "build": "turbo build --filter=astro-lqip --filter=astro-lqip-docs",
    "demos": "turbo demos --concurrency=2",
    "dev": "turbo dev",
    "lint": "turbo lint:oxlint lint:eslint",
    "lint:eslint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "oxlint . --fix --fix-suggestions --fix-dangerously && eslint --flag unstable_native_nodejs_ts_config . --cache --fix",
    "lint:oxlint": "oxlint .",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build",
    "preview": "turbo preview",
    "release": "bumpp packages/astro-lqip/package.json",
    "typecheck": "turbo typecheck:oxlint",
    "typecheck:oxlint": "oxlint . --type-aware --type-check"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": [
      "pnpm lint:fix",
      "pnpm astro:typecheck",
      "pnpm typecheck"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@felixicaza/eslint-config": "1.0.1",
    "@felixicaza/oxlint-config": "1.0.0",
    "@napi-rs/image": "1.15.0",
    "@tsdown/css": "0.21.10",
    "@types/node": "26.6.3",
    "@typescript-eslint/parser": "8.71.0",
    "bumpp": "12.3.0",
    "eslint": "10.11.0",
    "lightningcss": "1.33.0",
    "nano-staged": "1.0.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.21.10",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2"
    }
  }
}
