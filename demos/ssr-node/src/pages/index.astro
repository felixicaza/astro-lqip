---
import { Image, Picture, Background } from 'astro-lqip/components'

import volcanoImage from '../assets/pexels-fabianwiktor-3470872.jpg'
import volcanoSunsetImage from '../assets/pexels-fabianwiktor-3470482.jpg'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>astro-lqip ssr with node adapter configs demo</title>
  </head>
  <body>
    <div>
      <p>Background component ImageMetadata import</p>
      <Background src={volcanoSunsetImage}>
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component relative path import</p>
      <Background src="../assets/pexels-fabianwiktor-3470482.jpg">
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component absolute path import</p>
      <Background src="/src/assets/pexels-fabianwiktor-3470482.jpg">
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component alias path import</p>
      <Background src="@/assets/pexels-fabianwiktor-3470482.jpg">
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component with remote image</p>
      <Background src="https://images.pexels.com/photos/994605/pexels-photo-994605.jpeg">
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component with custom CSS variable</p>
      <Background cssVariable="--custom-background" src="/src/assets/pexels-fabianwiktor-3470482.jpg">
        <section class="custom-background">
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component in AVIF format</p>
      <Background format="avif" src="/src/assets/pexels-fabianwiktor-3470482.jpg">
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component with lqip color</p>
      <Background lqip="color" src="/src/assets/pexels-fabianwiktor-3470482.jpg">
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component in multiple formats</p>
      <Background format={['avif', 'webp', 'jpeg']} src="/src/assets/pexels-fabianwiktor-3470482.jpg">
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component with custom width and height</p>
      <Background height={720} src="/src/assets/pexels-fabianwiktor-3470482.jpg" width={720}>
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component with several props</p>
      <Background fit="cover" format="avif" height={720} quality={80} src="/src/assets/pexels-fabianwiktor-3470482.jpg" width={720} widths={[100, 1200, 1536]}>
        <section>
          <p>Optimized background</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Background component with lqip false</p>
      <Background lqip={false} src="/src/assets/pexels-fabianwiktor-3470482.jpg">
        <section>
          <p>Background without LQIP</p>
        </section>
      </Background>
    </div>
    <div>
      <p>Image and Picture components ImageMetadata import</p>
      <Image alt="A beautiful volcano" height={450} src={volcanoImage} width={450} />
      <Picture alt="A beautiful volcano in the sunset" height={450} src={volcanoImage} width={450} />
    </div>
    <div>
      <p>Image and Picture components relative path import</p>
      <Image alt="A beautiful volcano" height={450} src="../assets/pexels-fabianwiktor-3470872.jpg" width={450} />
      <Picture alt="A beautiful volcano in the sunset" height={450} src="../assets/pexels-fabianwiktor-3470872.jpg" width={450} />
    </div>
    <div>
      <p>Image and Picture components absolute path import</p>
      <Image alt="A beautiful volcano" height={450} src="/src/assets/pexels-fabianwiktor-3470872.jpg" width={450} />
      <Picture alt="A beautiful volcano in the sunset" height={450} src="/src/assets/pexels-fabianwiktor-3470872.jpg" width={450} />
    </div>
    <div>
      <p>Image and Picture components import with alias</p>
      <Image alt="A beautiful volcano" height={450} src="@/assets/pexels-fabianwiktor-3470872.jpg" width={450} />
      <Picture alt="A beautiful volcano in the sunset" height={450} src="@/assets/pexels-fabianwiktor-3470872.jpg" width={450} />
    </div>
    <div>
      <p>Image and Picture components with remote images</p>
      <Image alt="A beautiful volcano" height={450} src="https://images.pexels.com/photos/994605/pexels-photo-994605.jpeg" width={450} />
      <Picture alt="A beautiful volcano in the sunset" height={450} src="https://images.pexels.com/photos/994605/pexels-photo-994605.jpeg" width={450} />
    </div>
    <div>
      <p>Image and Picture components with lqip false</p>
      <Image alt="Volcano no LQIP" height={450} lqip={false} src={volcanoImage} width={450} />
      <Picture alt="Volcano no LQIP in the sunset" height={450} lqip={false} src={volcanoImage} width={450} />
    </div>
  </body>
</html>

<style>
  section {
    background: var(--background);
  }
  .custom-background {
    background: var(--custom-background);
  }
  section,
  .custom-background {
    background-size: cover;
    background-position: center;
    width: 100%;
    height: 300px;
  }
</style>
